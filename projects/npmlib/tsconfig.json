{
  "extends": [
    "@phanect/configs/ts", // TODO user @phanect/configs/ts/nodejs if this library is only for Node.js
    "@phanect/configs/ts/addons/npm"
  ],
  "compilerOptions": {
    // TODO add `dom` for frontend library.
    // `esnext` is added by default, so you don't have to add it to `lib` if you only need `esnext`.
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.mjs",
    "**/*.jsx"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
